<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:plugin="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             xmlns:interfaces="clr-namespace:Plugin.Maui.Calendar.Interfaces;assembly=Plugin.Maui.Calendar"
             xmlns:vm="clr-namespace:NamaskarApp.ViewModels"
             xmlns:models="clr-namespace:NamaskarApp.Models"
             xmlns:converters="clr-namespace:NamaskarApp.Converters"
             x:Class="NamaskarApp.MainPage"
             x:DataType="vm:CalendarViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource SkyLight}, Dark={StaticResource SkyDark}}">

    <ContentPage.Resources>
        <!-- Palette: Nepal flag blue for the shown month and selection, rhododendron crimson for Saturdays and
             public holidays (printed red on wall patros). -->
        <!-- Sky: shown behind the daily photo, and on its own when there is no photo -->
        <Color x:Key="SkyLight">#003893</Color>
        <Color x:Key="SkyDark">#0A1F4D</Color>
        <Color x:Key="OnPhoto">#FFFFFF</Color>
        <Color x:Key="OnPhotoMuted">#D9FFFFFF</Color>
        <Color x:Key="OnPhotoChip">#33FFFFFF</Color>
        <!-- Dark frosted glass (the Namaskar extension's container): a dark tint over the blurred photo with a
             faint light edge. Content on it is light; the same in light and dark theme. -->
        <Color x:Key="GlassFill">#73101418</Color>
        <Color x:Key="GlassStroke">#2EFFFFFF</Color>
        <Color x:Key="OnGlass">#FFFFFF</Color>
        <Color x:Key="OnGlassMuted">#A6FFFFFF</Color>
        <Color x:Key="TodayOnGlass">#33FFFFFF</Color>
        <Color x:Key="SelectedOnGlass">#2D5BD3</Color>
        <Color x:Key="RedOnGlass">#FF6B7F</Color>
        <Color x:Key="HolidayChipOnGlass">#4DC8102E</Color>
        <Color x:Key="FlagBlue">#003893</Color>
        <Color x:Key="Crimson">#C8102E</Color>

        <converters:RedDayConverter x:Key="RedDayConverter" />

        <Style x:Key="WeekdayTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextColor" Value="{StaticResource OnGlassMuted}" />
        </Style>

        <Style x:Key="ChevronButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="TextColor" Value="{StaticResource OnPhoto}" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="TextColor" Value="{StaticResource OnGlass}" />
        </Style>

        <Style x:Key="BodyLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="1.2" />
            <Setter Property="TextColor" Value="{StaticResource OnGlass}" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <!-- Daily photo as a skin: sharp on the welcome screen, blurred behind the calendar's frosted cards.
             The blur is a tiny copy of the photo stretched over the screen, so it costs nothing to render. -->
        <Image Source="{Binding Background.ImageUrl}" Aspect="AspectFill" />
        <Image x:Name="BlurredPhoto" Source="{Binding Background.BlurImageUrl}" Aspect="AspectFill" Opacity="0" />
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#8C000000" Offset="0" />
                    <GradientStop Color="#33000000" Offset="0.35" />
                    <GradientStop Color="#99000000" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

    <ScrollView x:Name="CalendarContent" IsVisible="False" Opacity="0">
        <VerticalStackLayout Padding="16,24,16,32" Spacing="16">

            <!-- Header: BS month and year, with the AD months it spans -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label FontSize="30" FontFamily="OpenSansSemibold" LineBreakMode="NoWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding MonthName}" TextColor="{StaticResource OnPhoto}" />
                                <Span Text=" " />
                                <Span Text="{Binding Year}" FontFamily="OpenSansRegular" TextColor="{StaticResource OnPhoto}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="{Binding EnglishMonthSpan}" FontSize="14" TextColor="{StaticResource OnPhotoMuted}" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Today"
                        Command="{Binding GoToTodayCommand}"
                        FontSize="14"
                        FontFamily="OpenSansSemibold"
                        Padding="14,0"
                        HeightRequest="36"
                        CornerRadius="18"
                        VerticalOptions="Center"
                        BackgroundColor="{StaticResource OnPhotoChip}"
                        TextColor="{StaticResource OnPhoto}"
                        SemanticProperties.Hint="Shows the current month and selects today" />
                <Button Grid.Column="2"
                        Text="‹"
                        Command="{Binding PrevLayoutUnitCommand, Source={x:Reference NepaliCalendar}, x:DataType=plugin:Calendar}"
                        Style="{StaticResource ChevronButtonStyle}"
                        SemanticProperties.Description="Previous month" />
                <Button Grid.Column="3"
                        Text="›"
                        Command="{Binding NextLayoutUnitCommand, Source={x:Reference NepaliCalendar}, x:DataType=plugin:Calendar}"
                        Style="{StaticResource ChevronButtonStyle}"
                        SemanticProperties.Description="Next month" />
            </Grid>

            <!-- Month grid -->
            <Border Padding="8,14,8,10"
                    Stroke="{StaticResource GlassStroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{StaticResource GlassFill}">
                <plugin:Calendar x:Name="NepaliCalendar"
                                 CalendarSystem="{Binding CalendarSystem}"
                                 ShownDate="{Binding ShownDate, Mode=TwoWay}"
                                 SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                 FirstDayOfWeek="Sunday"
                                 HeaderSectionVisible="False"
                                 FooterSectionVisible="False"
                                 EventsScrollViewVisible="False"
                                 SwipeUpToHideEnabled="False"
                                 UseAbbreviatedDayNames="True"
                                 DaysTitleLabelFirstUpperRestLower="True"
                                 DaysTitleLabelStyle="{StaticResource WeekdayTitleStyle}"
                                 WeekendTitleStyle="{StaticResource WeekdayTitleStyle}"
                                 DayViewSize="46"
                                 DayViewHeight="56">
                    <plugin:Calendar.DayViewTemplate>
                        <!-- Wall-patro cell: large BS day, small AD day in the corner.
                             Cells are reused across months, so each property is driven by one trigger or binding
                             only: MAUI restores the wrong value when two triggers set the same property and turn
                             off in a different order. That is why the selected day number is a separate label. -->
                        <DataTemplate x:DataType="interfaces:ICalendarDay">
                            <Grid Margin="2">
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsThisMonth}" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </DataTrigger>
                                </Grid.Triggers>
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        IsVisible="{Binding IsToday}"
                                        BackgroundColor="{StaticResource TodayOnGlass}" />
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        IsVisible="{Binding IsSelected}"
                                        BackgroundColor="{StaticResource SelectedOnGlass}" />
                                <Grid>
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid" Binding="{Binding IsDisabled}" Value="True">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </DataTrigger>
                                    </Grid.Triggers>
                                    <Label Text="{Binding Date, StringFormat='{0:%d}'}"
                                           FontSize="10"
                                           Margin="0,3,5,0"
                                           HorizontalOptions="End"
                                           VerticalOptions="Start"
                                           TextColor="{StaticResource OnGlassMuted}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="#C9D6F2" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <!-- Unselected day number: crimson on Saturdays and public holidays -->
                                    <Label Text="{Binding Day}"
                                           FontSize="21"
                                           FontFamily="OpenSansSemibold"
                                           Margin="0,6,0,0"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource OnGlass}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Date, Converter={StaticResource RedDayConverter}}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource RedOnGlass}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <!-- Selected day number -->
                                    <Label Text="{Binding Day}"
                                           IsVisible="{Binding IsSelected}"
                                           FontSize="21"
                                           FontFamily="OpenSansSemibold"
                                           Margin="0,6,0,0"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="White" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </plugin:Calendar.DayViewTemplate>
                </plugin:Calendar>
            </Border>

            <!-- Selected day -->
            <Border Padding="16,14,16,16"
                    Stroke="{StaticResource GlassStroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{StaticResource GlassFill}">
            <VerticalStackLayout Spacing="6">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding SelectedNepaliDate}"
                           FontSize="20"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource OnGlass}" />
                    <Label Text="{Binding SelectedEnglishDate}"
                           FontSize="15"
                           TextColor="{StaticResource OnGlassMuted}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="8">
                    <Border Padding="10,4"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            IsVisible="{Binding SelectedTithi, Converter={x:Static converters:StringHasTextConverter.Instance}}"
                            BackgroundColor="{StaticResource TodayOnGlass}">
                        <Label FontSize="13"
                               TextColor="{StaticResource OnGlass}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding SelectedTithi}" FontFamily="OpenSansSemibold" />
                                    <Span Text=" tithi" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                    <Border Padding="10,4"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            IsVisible="{Binding IsSelectedDayHoliday}"
                            BackgroundColor="{StaticResource HolidayChipOnGlass}">
                        <Label Text="Public holiday"
                               FontSize="13"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource RedOnGlass}" />
                    </Border>
                </HorizontalStackLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedDayEvents}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}" Style="{StaticResource BodyLabelStyle}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
            </Border>

            <!-- Holidays of the shown month, as printed at the foot of a wall patro -->
            <Border Padding="16,12,16,16"
                    Stroke="{StaticResource GlassStroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    IsVisible="{Binding HasMonthHolidays}"
                    BackgroundColor="{StaticResource GlassFill}">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource SectionTitleStyle}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Holidays in " />
                                <Span Text="{Binding MonthName}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MonthHolidays}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MonthHoliday">
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                    <Label Text="{Binding Day}"
                                           FontSize="17"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource RedOnGlass}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Names}"
                                           Style="{StaticResource BodyLabelStyle}"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Photo credit; opens the photographer's page -->
            <Label Text="{Binding PhotoCredit}"
                   IsVisible="{Binding PhotoCredit, Converter={x:Static converters:StringHasTextConverter.Instance}}"
                   FontSize="12"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource OnPhotoMuted}"
                   SemanticProperties.Hint="Opens the photographer's page">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenPhotoSourceCommand}" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>

        <!-- Welcome: today at a glance on the clean photo; tap or swipe up to open the calendar -->
        <Grid x:Name="WelcomeLayer"
              x:DataType="vm:WelcomeViewModel"
              BindingContext="{Binding Welcome, x:DataType=vm:CalendarViewModel}"
              RowDefinitions="*,Auto"
              Padding="24,48,24,28">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenCalendarCommand}" />
                <SwipeGestureRecognizer Direction="Up" Command="{Binding OpenCalendarCommand}" />
            </Grid.GestureRecognizers>

            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Greeting}" FontSize="20" TextColor="{StaticResource OnPhotoMuted}" />
                <Label Text="{Binding NepaliDate}"
                       FontSize="58"
                       FontFamily="OpenSansSemibold"
                       Margin="0,8,0,0"
                       TextColor="{StaticResource OnPhoto}" />
                <Label Text="{Binding NepaliYear}" FontSize="30" TextColor="{StaticResource OnPhoto}" />
                <Label Text="{Binding EnglishDate}"
                       FontSize="16"
                       Margin="0,10,0,0"
                       TextColor="{StaticResource OnPhotoMuted}" />

                <HorizontalStackLayout Spacing="8" Margin="0,16,0,0">
                    <Border Padding="12,5"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            IsVisible="{Binding Tithi, Converter={x:Static converters:StringHasTextConverter.Instance}}"
                            BackgroundColor="{StaticResource OnPhotoChip}">
                        <Label FontSize="14" TextColor="{StaticResource OnPhoto}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Tithi}" FontFamily="OpenSansSemibold" />
                                    <Span Text=" tithi" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                    <Border Padding="12,5"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            IsVisible="{Binding IsHoliday}"
                            BackgroundColor="{StaticResource Crimson}">
                        <Label Text="Public holiday" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource OnPhoto}" />
                    </Border>
                </HorizontalStackLayout>
                <Label Text="{Binding Highlights}"
                       IsVisible="{Binding Highlights, Converter={x:Static converters:StringHasTextConverter.Instance}}"
                       FontSize="17"
                       Margin="0,8,0,0"
                       TextColor="{StaticResource OnPhoto}" />

                <!-- Asked once; the name stays on this phone -->
                <Border IsVisible="{Binding IsNamePromptVisible}"
                        Margin="0,24,0,0"
                        Padding="16,14"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#4D000000">
                    <Border.GestureRecognizers>
                        <!-- Keeps taps inside the card from opening the calendar -->
                        <TapGestureRecognizer />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="What should we call you?"
                               FontSize="16"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource OnPhoto}" />
                        <Entry Text="{Binding NameInput}"
                               Placeholder="Your name"
                               PlaceholderColor="#99FFFFFF"
                               TextColor="{StaticResource OnPhoto}"
                               ReturnType="Done"
                               ReturnCommand="{Binding SaveNameCommand}" />
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Save name"
                                    Command="{Binding SaveNameCommand}"
                                    FontFamily="OpenSansSemibold"
                                    HeightRequest="38"
                                    Padding="16,0"
                                    CornerRadius="19"
                                    BackgroundColor="{StaticResource OnPhoto}"
                                    TextColor="{StaticResource FlagBlue}" />
                            <Button Text="Not now"
                                    Command="{Binding SkipNameCommand}"
                                    HeightRequest="38"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource OnPhoto}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1"
                                 Spacing="0"
                                 HorizontalOptions="Center"
                                 SemanticProperties.Description="Open the calendar">
                <Label Text="⌃" FontSize="26" HorizontalOptions="Center" TextColor="{StaticResource OnPhoto}" />
                <Label Text="Swipe up or tap for the calendar" FontSize="14" TextColor="{StaticResource OnPhotoMuted}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
