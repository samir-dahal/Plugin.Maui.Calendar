<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:plugin="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             x:Class="NamaskarApp.MainPage">

    <VerticalStackLayout Padding="16" Spacing="12">
        <plugin:Calendar
            x:Name="NepaliCalendar"
            FirstDayOfWeek="Sunday"
            EventsScrollViewVisible="False" />

        <Label x:Name="SelectedDateLabel" HorizontalOptions="Center" />
    </VerticalStackLayout>

</ContentPage>
